# Test-only. NEVER set DEMO_SEED=1 for real organizations.
# DEMO_SEED=1
# For a non-demo first account, set the following 3 values BEFORE first run.
BOOTSTRAP_ORG=My Company
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=replace-this-with-a-strong-password
# Optional: persistent storage paths, not public web directories
# JARVIS_DB_PATH=/secure-persistent-volume/works.db
# JARVIS_BACKUP_DIR=/secure-persistent-volume/backups
# ENABLE_API_DOCS=1

# Secure-cookie mode (HTTPS) is the default. For LOCAL demo only, use run_demo.sh.
# JW_INSECURE_LOCAL_DEV=1 must NEVER be used on a public or production server.
JW_ENV=development

# V1.7 optional test/dev features. DO NOT COMMIT ACTUAL VALUES.
# JW_DATA_KEY=<new Fernet.generate_key() output; place in a secure secret manager>
# JW_UPLOAD_SCAN=clamav  # requires clamscan + updated signature database
# JW_IMPORT_TIMEOUT=18   # 5..60s; parser worker has additional resource limits
# JW_ENV=production will intentionally refuse startup pending RLS + security audit.

# V8.4 read-only PG shadow API -- ISOLATED DEV ONLY, defaults OFF.
# This does not replace SQLite auth/login or migrate sessions.
# DO NOT enable on the deployed production server.
# JW_PG_STAGE_V84=ISOLATED_DEV_READ_ONLY
# JW_PG_STAGE_DSN=postgresql://<restricted-login>:<secret>@<dev-pg-host>:5432/postgres
# Use SSL verification; credential must be a dedicated NON-privileged LOGIN
# with permission to SET ROLE jw_app_dev and no other privileged memberships.
# Do NOT use postgres, supabase_admin, service_role or API secret keys.
# Stage routes require a pre-existing PostgreSQL sessions row; no fallback to SQLite.
