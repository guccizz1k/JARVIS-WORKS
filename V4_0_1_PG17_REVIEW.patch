+    admin = {'dbname': 'jw_v20_test_abcdef123456', 'user': 'postgres',
+             'host': '127.0.0.1', 'port': '5432', 'password': 'admin-only'}
+    app = {**admin, 'user': 'jw_app', 'password': 'synthetic', **patch}
